<?xml version="1.0" encoding="utf-8"?>
<!--
  Album art for the shuffle tiles on the Home tab. Full-bleed rather than a bare icon:
  these sit in a grid beside real album artwork, and a plain icon rendered as a small glyph
  floating on the system background while its neighbours were solid squares.

  The fill is a gradient rather than a flat colour, and deliberately lighter than it looks it
  should be: the AAOS media host paints its own background at roughly #181C1F, so a tile in
  the app's own #0E1011 family is invisible against it. Measured on a head unit, not guessed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <path android:pathData="M0,0h512v512h-512z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="512"
                android:endY="512"
                android:type="linear">
                <item android:color="#313D42" android:offset="0" />
                <item android:color="#212B2F" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:scaleX="9"
        android:scaleY="9"
        android:translateX="148"
        android:translateY="148">
        <path
            android:pathData="M16,3h5v5"
            android:strokeColor="#DAEAEA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M4,20L21,3"
            android:strokeColor="#DAEAEA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M21,16v5h-5"
            android:strokeColor="#DAEAEA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M15,15l6,6"
            android:strokeColor="#DAEAEA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M4,4l5,5"
            android:strokeColor="#DAEAEA"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
